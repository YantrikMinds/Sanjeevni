(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svgprecision 4)
      (excludeedgelayer true)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfpolygonmode true)
      (dxfimperialunits true)
      (dxfusepcbnewfont true)
      (psnegative false)
      (psa4output false)
      (plotreference true)
      (plotvalue true)
      (plotinvisibletext false)
      (sketchpadsonfab false)
      (subtractmaskfromsilk false)
      (outputformat 1)
      (mirror false)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerber/")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "+VBAT")
  (net 4 "+VBAT_SW")
  (net 5 "+VBUS")
  (net 6 "MOT_L_FWD")
  (net 7 "MOT_L_REV")
  (net 8 "MOT_R_FWD")
  (net 9 "MOT_R_REV")
  (net 10 "MOT_OUT1")
  (net 11 "MOT_OUT2")
  (net 12 "MOT_OUT3")
  (net 13 "MOT_OUT4")
  (net 14 "I2C_SCL")
  (net 15 "I2C_SDA")
  (net 16 "IR_LED_GATE")

  ;; -------------------------------------------------------------------
  ;; BOARD OUTLINE (EDGE.CUTS): 48.0 mm (W) x 46.0 mm (H)
  ;; -------------------------------------------------------------------
  (gr_rect (start 100 100) (end 148 146) (layer "Edge.Cuts") (width 0.15) (fill none))

  ;; -------------------------------------------------------------------
  ;; MOUNTING HOLES: 4x M2 Holes with 3.0mm Ground Pad
  ;; -------------------------------------------------------------------
  (footprint "MountingHole:MountingHole_2.2mm_M2_Pad" (layer "F.Cu")
    (at 103 103)
    (pad "1" thru_hole circle (at 0 0) (size 3.8 3.8) (drill 2.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_2.2mm_M2_Pad" (layer "F.Cu")
    (at 145 103)
    (pad "1" thru_hole circle (at 0 0) (size 3.8 3.8) (drill 2.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_2.2mm_M2_Pad" (layer "F.Cu")
    (at 103 143)
    (pad "1" thru_hole circle (at 0 0) (size 3.8 3.8) (drill 2.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_2.2mm_M2_Pad" (layer "F.Cu")
    (at 145 143)
    (pad "1" thru_hole circle (at 0 0) (size 3.8 3.8) (drill 2.2) (layers *.Cu *.Mask) (net 1 "GND"))
  )

  ;; -------------------------------------------------------------------
  ;; SILKSCREEN BRANDING
  ;; -------------------------------------------------------------------
  (gr_text "⚡ SANJEEVNI NANO ROVER v1.0" (at 124 105) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.2) bold))
  )
  (gr_text "Team Aprajit - Disaster Robotics" (at 124 108) (layer "F.SilkS")
    (effects (font (size 0.9 0.9) (thickness 0.15)))
  )
  (gr_text "ANTENNA KEEP-OUT" (at 124 113) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (gr_text "FRONT CAMERA" (at 124 102) (layer "F.SilkS")
    (effects (font (size 0.9 0.9) (thickness 0.15)))
  )
  (gr_text "USB-C CHARGE" (at 124 144) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (gr_text "LEFT MOT" (at 104 125 90) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (gr_text "RIGHT MOT" (at 144 125 270) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
)
